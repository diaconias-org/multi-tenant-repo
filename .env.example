# Configuração do Banco de Dados com Prisma
# Para SQLite local: "file:./dev.db"
# Para PostgreSQL: "postgresql://usuario:senha@host:5432/diaconia?schema=public&sslmode=require"
DATABASE_URL="file:./dev.db"

# Usuário Administrador Padrão (utilizado pelo seed)
DEFAULT_ADMIN_EMAIL="admin@diaconia.org"
DEFAULT_ADMIN_PASSWORD="admin123change"
DEFAULT_ADMIN_NOME="Administrador Diaconia"

# Segredo de Sessão (NextAuth v5)
AUTH_SECRET="gere-um-segredo-com-openssl-rand-hex-32"
NEXTAUTH_SECRET="gere-um-segredo-com-openssl-rand-hex-32"

# Storage (opcional para Vercel Blob)
# BLOB_READ_WRITE_TOKEN=""
